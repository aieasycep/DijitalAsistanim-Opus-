# ─────────────────────────────────────────────────────────────────────────────
# Dijital Asistan — environment template
#
# Copy to `.env` and fill in what you have. NOTHING here is required to run the
# app locally: with no Supabase project configured the mobile app boots in demo
# mode against deterministic local fixtures, and every integration below has a
# working fallback (device TTS instead of a speech provider, full-text search
# instead of embeddings, and so on).
#
# Two hard rules:
#   • Only `EXPO_PUBLIC_*` and `NEXT_PUBLIC_*` values reach a client bundle.
#     Never put a secret behind one of those prefixes — it ships in the binary.
#   • Everything else is a server-side secret, set with
#     `supabase secrets set KEY=value`, and is never committed.
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL and anon key are public by design (RLS is what protects the data).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. The service role bypasses RLS entirely — it must never be
# exposed to a client, a browser, or a build log.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres


# ── Token encryption ─────────────────────────────────────────────────────────
# 32 bytes, base64. Encrypts provider refresh tokens at rest with AES-256-GCM.
# Generate:  openssl rand -base64 32
# Rotating this requires re-encrypting `oauth_credentials`; see docs/SECURITY.md.
OAUTH_ENCRYPTION_KEY=
OAUTH_ENCRYPTION_KEY_VERSION=1


# ── Google OAuth (Gmail, Calendar, Tasks) ────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
# Read scopes are requested at connect time; send/write scopes are requested
# only when the user first takes an action that needs them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<project-ref>.supabase.co/functions/v1/oauth-google-callback
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Optional: Gmail push notifications. Without these the app polls instead, which
# works fine — it is just less immediate.
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=


# ── Microsoft OAuth (Outlook, Calendar, To Do) ───────────────────────────────
# Portal: https://entra.microsoft.com → App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=https://<project-ref>.supabase.co/functions/v1/oauth-microsoft-callback
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=

# Optional: Microsoft Graph change subscriptions. Falls back to polling.
MICROSOFT_WEBHOOK_SECRET=
MICROSOFT_WEBHOOK_URL=


# ── AI provider ──────────────────────────────────────────────────────────────
# `anthropic` or `openai`. The other keys stay unset; the adapter picks one.
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# Cheap model for classification, capable model for briefings and the assistant.
ANTHROPIC_CLASSIFY_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_REASONING_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_CLASSIFY_MODEL=gpt-4.1-mini
OPENAI_REASONING_MODEL=gpt-4.1

# Optional second provider used only when the primary is unavailable.
AI_FALLBACK_PROVIDER=


# ── Embeddings (semantic memory) ─────────────────────────────────────────────
# Unset → the assistant and search fall back to PostgreSQL full-text search.
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536


# ── Speech ───────────────────────────────────────────────────────────────────
# Text-to-speech for the audio briefing. Unset → on-device speech synthesis,
# which is the fallback tier and works offline.
TTS_PROVIDER=
TTS_API_KEY=
TTS_VOICE_ID=
TTS_MODEL=

# Speech-to-text for the voice assistant. Unset → the microphone button is
# hidden rather than shown and broken.
STT_PROVIDER=
STT_API_KEY=
STT_MODEL=


# ── Subscriptions (RevenueCat) ───────────────────────────────────────────────
# Unset → the paywall renders with the fallback pricing copy and purchases are
# disabled; entitlements still resolve (referral bonuses keep working).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH_HEADER=
REVENUECAT_ENTITLEMENT_ID=pro
REVENUECAT_PRODUCT_MONTHLY=da_pro_monthly
REVENUECAT_PRODUCT_ANNUAL=da_pro_annual


# ── Push notifications ───────────────────────────────────────────────────────
# An Expo access token is only needed for server-initiated pushes from an edge
# function; the client registers its own token without one.
EXPO_ACCESS_TOKEN=
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send


# ── Observability ────────────────────────────────────────────────────────────
# Both are optional; the adapters no-op when unset.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=


# ── Routes / maps (optional) ─────────────────────────────────────────────────
# Only used to show real travel time between two events that both have a
# location. Unset → travel time is not shown at all; it is never estimated.
ROUTES_PROVIDER=
ROUTES_API_KEY=


# ── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://dijitalasistan.app
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=destek@dijitalasistan.app
NEXT_PUBLIC_PRIVACY_EMAIL=gizlilik@dijitalasistan.app

# App/universal link verification. Both files are served from the web app.
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.dijitalasistan.app
ANDROID_PACKAGE_NAME=com.dijitalasistan.app
ANDROID_SHA256_FINGERPRINT=


# ── Mobile build identifiers ─────────────────────────────────────────────────
APP_BUNDLE_ID=com.dijitalasistan.app
APP_ANDROID_PACKAGE=com.dijitalasistan.app
APP_SCHEME=dijitalasistan
APP_IOS_APP_GROUP=group.com.dijitalasistan.app
APP_DISPLAY_NAME=Dijital Asistan
APP_VERSION=1.0.0
APP_IOS_BUILD_NUMBER=1
APP_ANDROID_VERSION_CODE=1
EXPO_PUBLIC_WEB_URL=https://dijitalasistan.app
EAS_PROJECT_ID=


# ── Local development ────────────────────────────────────────────────────────
# `local` or `demo` enables the seeded Turkish demo dataset. A production
# deployment must leave this unset — the seed refuses to apply otherwise.
APP_ENVIRONMENT=local
# Forces the mobile app into fixture-backed demo mode regardless of Supabase
# config. Never set this in a release build.
EXPO_PUBLIC_DEMO_MODE=
# Pins "now" for the demo fixtures so screenshots and tests are reproducible.
DEMO_NOW=
