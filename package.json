{
  "name": "dijital-asistan",
  "version": "1.0.0",
  "private": true,
  "description": "Dijital Asistan \u2014 proactive personal command center for email, calendar and commitments.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:mobile": "pnpm --filter @da/mobile run test",
    "build:web": "pnpm --filter @da/web run build",
    "dev:backoffice": "pnpm --filter @da/backoffice run dev",
    "build:backoffice": "pnpm --filter @da/backoffice run build",
    "test:backoffice-e2e": "pnpm --filter @da/backoffice run test:e2e",
    "verify:mobile": "pnpm --filter @da/mobile run verify",
    "verify:supabase": "node scripts/validate-supabase.mjs",
    "verify:i18n": "node scripts/check-i18n-keys.mjs",
    "verify:e2e-ids": "node scripts/check-maestro-ids.mjs",
    "verify:wiring": "node scripts/check-wiring.mjs",
    "verify:no-dead-code": "node scripts/check-no-dead-code.mjs",
    "verify:secrets": "node scripts/check-secrets.mjs",
    "verify:rbac-doc": "node scripts/check-rbac-doc.mjs",
    "assets:generate": "node scripts/generate-brand-assets.mjs",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:mobile && pnpm run verify:supabase && pnpm run verify:i18n && pnpm run verify:e2e-ids && pnpm run verify:wiring && pnpm run verify:no-dead-code && pnpm run verify:secrets && pnpm run verify:rbac-doc"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4"
  }
}
